{
  "name": "ai-video-studio",
  "version": "1.0.2",
  "description": "AI Video Studio — tạo video tự động (dài tuỳ ý) cho macOS. Node 22 backend + native WKWebView shell.",
  "type": "module",
  "main": "shell/electron/main.cjs",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:smoke": "node scripts/tpl-smoke.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "fonts:build": "node scripts/build-fonts.mjs",
    "fonts:build:ui": "node scripts/build-fonts.mjs --ui",
    "icon:build": "node scripts/build-icon.mjs",
    "shell:build": "bash shell/build-app.sh",
    "libs:build": "node scripts/build-libs.mjs",
    "whisper:build": "node scripts/build-whisper-model.mjs",
    "node:fetch": "node scripts/fetch-node.mjs",
    "ffmpeg:fetch:win": "node scripts/fetch-ffmpeg-win.mjs",
    "shell:build:dist": "bash shell/build-app.sh --dist",
    "release": "node scripts/release.mjs",
    "win:build": "node scripts/build-windows.mjs",
    "electron:mac": "electron-builder --mac --publish never",
    "electron:dev": "electron shell/electron/main.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "express": "^4.21.2",
    "msedge-tts": "^2.0.6",
    "multer": "^1.4.5-lts.1",
    "puppeteer-core": "^23.11.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^42.9.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.tuila1freelancer.aivideostudio",
    "productName": "AI Video Studio",
    "directories": {
      "output": "dist/electron",
      "buildResources": "shell"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "shell/electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/**/test/**",
      "!**/node_modules/**/*.md"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "AI Video Studio"
    },
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.video"
    }
  }
}
