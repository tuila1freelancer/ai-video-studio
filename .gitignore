node_modules/
data/
# Runtimes and binaries are fetched per machine; the small web assets every render needs are
# committed so a fresh clone renders, and tests hash, exactly the same bytes.
vendor/*
!vendor/fonts/
!vendor/libs/
!vendor/gsap/
vendor/fonts/*.bak
*.log
.DS_Store
# Local editor settings
.vscode/
.idea/
# Build artefacts, including dist/private/*.map — the release sourcemap, which would undo the
# whole point of shipping bytecode if it ever left this machine.
dist/
AI Video Studio.app/
shell/build/

# Electron build output — 99 MB artifacts, rebuilt on demand
dist/electron/

# Release credentials — TOOLS_STORE_* keys are live; a single `git add -A` would publish them.
.env
.env.*
!.env.example
